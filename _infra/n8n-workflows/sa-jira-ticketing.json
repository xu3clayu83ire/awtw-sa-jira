  "name": "sa-jira-ticketing",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sa-jira-ticketing",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "sa-jira-ticketing"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst payload = raw.body || raw;\nconst tasks = payload.tasks || [];\nif (!Array.isArray(tasks) || tasks.length === 0) {\n  throw new Error('tasks 欄位缺漏或為空陣列');\n}\nreturn tasks.map(task => {\n  if (!task.title || !task.role || !task.executorType) {\n    return { json: { _error: true, reason: `任務缺少必填欄位: ${JSON.stringify(task)}` } };\n  }\n  return {\n    json: {\n      fields: {\n        project: { key: 'ASJ' },\n        summary: task.title,\n        issuetype: { name: 'Task' },\n        labels: [task.role, task.executorType]\n      }\n    }\n  };\n});"
      },
      "id": "code-node-1",
      "name": "Parse Task Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://prostyliu.atlassian.net/rest/api/3/issue",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { fields: $json.fields } }}",
        "options": {}
      },
      "id": "http-node-1",
      "name": "Create Jira Issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "continueOnFail": true,
      "credentials": {
        "httpBasicAuth": {
          "id": "yxB1ChdyDb8goUKo",
          "name": "Jira ASJ"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all();\nconst issues = [];\nconst errors = [];\nfor (const item of results) {\n  const j = item.json;\n  if (j._error) {\n    errors.push(j.reason);\n  } else if (j.error || j.errorMessages) {\n    errors.push(JSON.stringify(j));\n  } else if (j.key) {\n    issues.push({ key: j.key, url: j.self || null });\n  } else {\n    errors.push('未知回應格式: ' + JSON.stringify(j));\n  }\n}\nreturn [{\n  json: {\n    created: issues.length,\n    issues,\n    errors: errors.length > 0 ? errors : undefined\n  }\n}];"
      },
      "id": "code-node-2",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": "={{ $json.errors ? 207 : 200 }}"
        }
      },
      "id": "respond-node-1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        300
      ]
    }
  ],
  "connections": {
